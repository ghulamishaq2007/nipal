rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin write helper - check if authenticated user exists
    function isAdmin() {
      return request.auth != null;
    }

    // Helper to validate input string size
    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Public readable content for website
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /hero/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /slides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /navigation/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings & Reservations: Public can create, Admin can read, update, delete
    match /reservations/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Orders: Public can create, Admin can read, update, delete
    match /orders/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages: Public can create, Admin can read, update, delete
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // System backups collection (Admin only)
    match /backups/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
